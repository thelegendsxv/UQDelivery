# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a Git.

POSTGRES_DB=uqdelivery
POSTGRES_USER=uqdelivery
POSTGRES_PASSWORD=cambia-esta-clave

# Secreto del JWT en Base64 (minimo 32 bytes). En PowerShell puedes generar uno con:
#   $b = New-Object byte[] 48; (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

CORS_ORIGINS=http://localhost:5173

# Puertos en tu computador (cambialos si ya estan ocupados)
DB_PORT=5432
BACKEND_PORT=8090

# Administrador inicial: agrega aqui las variables que usa AdminSeeder (ver docs/HU-02-perfiles-roles.md)

# HU-04 / HU-05: mapas (busqueda de direcciones y distancia por calles). Clave gratis en https://developer.tomtom.com
TOMTOM_API_KEY=

# HU-03: correo real para recuperar la contrasena. Con Gmail: activa la verificacion en 2 pasos y crea una
# "contrasena de aplicacion" en https://myaccount.google.com/apppasswords (16 letras, sin espacios).
# Si MAIL_HOST queda vacio, en desarrollo el enlace solo se escribe en la terminal del backend.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=
MAIL_FROM=tu-correo@gmail.com
FRONTEND_URL=http://localhost:5173
